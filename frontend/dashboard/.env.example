# API origin only; do not append /api/v1. HTTPS is required except loopback HTTP.
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public browser key only. Never use a secret/service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_key
