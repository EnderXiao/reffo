{
  "name": "reffo-taro",
  "version": "1.0.0",
  "private": true,
  "description": "reffo taro frontend",
  "templateInfo": {
    "name": "react-native",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5 --no-check",
    "serve:h5": "npx --yes http-server dist -p 4173 -c-1",
    "build:rn": "./scripts/build-rn.sh",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "./scripts/build-rn.sh --watch --port 8083",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "android": "export JAVA_HOME=\"$(/usr/libexec/java_home -v 17 2>/dev/null || echo \"$JAVA_HOME\")\" && ./scripts/rn-cli.sh run-android --no-packager --port 8083",
    "ios": "./scripts/rn-cli.sh run-ios --no-packager --port 8083",
    "start": "./scripts/rn-cli.sh start --port 8083",
    "podInstall": "pod-install",
    "upgradePeerdeps": "install-peerdeps @tarojs/taro-rn@4.1.9 -o -P && install-peerdeps @tarojs/components-rn@4.1.9 -o -P && install-peerdeps @tarojs/router-rn@4.1.9 -o -P && pod-install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/cli-platform-android": "^12.3.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-native-community/slider": "4.4.2",
    "@react-native-picker/picker": "2.6.1",
    "@react-native/gradle-plugin": "^0.73.0",
    "@tarojs/components": "4.1.9",
    "@tarojs/components-rn": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-platform-alipay": "4.1.9",
    "@tarojs/plugin-platform-h5": "4.1.9",
    "@tarojs/plugin-platform-jd": "4.1.9",
    "@tarojs/plugin-platform-qq": "4.1.9",
    "@tarojs/plugin-platform-swan": "4.1.9",
    "@tarojs/plugin-platform-tt": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/rn-supporter": "4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/runtime-rn": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "@tarojs/taro-rn": "4.1.9",
    "classnames": "^2.5.1",
    "expo": "~50.0.0",
    "expo-av": "~13.10.6",
    "expo-barcode-scanner": "~12.9.3",
    "expo-blur": "~12.9.2",
    "expo-brightness": "~11.8.0",
    "expo-camera": "~14.1.3",
    "expo-file-system": "~16.0.9",
    "expo-image-picker": "~14.7.1",
    "expo-keep-awake": "~12.8.2",
    "expo-location": "~16.5.5",
    "expo-sensors": "~12.9.1",
    "react": "^18",
    "react-dom": "^18.2.0",
    "react-native": "^0.73.1",
    "react-native-device-info": "^14.1.1",
    "react-native-gesture-handler": "~2.14.1",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-pager-view": "6.2.3",
    "react-native-root-siblings": "^5.0.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-webview": "13.6.4",
    "three": "^0.185.0",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.2.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@react-native/babel-preset": "^0.73.18",
    "@react-native/metro-config": "^0.73.2",
    "@react-native/typescript-config": "^0.73.1",
    "@tarojs/cli": "4.1.9",
    "@tarojs/rn-runner": "4.1.9",
    "@tarojs/taro-loader": "4.1.9",
    "@tarojs/webpack5-runner": "4.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.11",
    "@types/react": "^18.2.6",
    "@types/three": "^0.185.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "babel-jest": "^30.2.0",
    "babel-plugin-global-define": "1.0.3",
    "babel-plugin-transform-react-jsx-to-rn-stylesheet": "4.1.9",
    "babel-preset-taro": "4.1.9",
    "eslint": "^8.19.0",
    "eslint-config-taro": "4.1.9",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "identity-obj-proxy": "^3.0.0",
    "install-peerdeps": "^3.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pod-install": "^0.1.23",
    "postcss": "^8.4.18",
    "react-refresh": "^0.11.0",
    "stylelint": ">=16.4.0 <=16.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.0",
    "webpack": "^5.78.0"
  }
}
