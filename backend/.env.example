# Environment Configuration
#
# 后端不再使用单个 .env 同时承载多套环境。
# 按用途复制本模板到以下未提交文件之一：
#
# - .env.local: 本地 SQLite 开发
# - .env.nonprod: 非生产 Supabase
# - .env.prod: 正式 Supabase
#
# 启动时通过 package.json 脚本显式选择 env 文件，例如：
# bun run dev:local
# bun run dev:nonprod
# bun run start:prod

# Runtime Environment
# local: 本地开发，默认 SQLite；nonprod: 测试/预发合并环境；prod: 正式环境
APP_ENV=local
DATABASE_PROVIDER=sqlite
# local / nonprod 可设为 false 使用 DEV_USER_ID；prod 必须为 true
AUTH_REQUIRED=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Supabase Configuration
# nonprod/prod 使用各自 Supabase project 的 URL、Publishable key 和 Secret key
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 标记当前 Supabase project 属于非生产还是正式；DATABASE_PROVIDER=supabase 时必填
SUPABASE_PROJECT_ENV=
SUPABASE_STORAGE_BUCKET=user-files
# Supabase 邮箱验证码配置。需与 Supabase Auth 邮件模板/项目设置保持一致。
AUTH_OTP_LENGTH=6
AUTH_OTP_RESEND_SECONDS=60
# 应用层密码加密私钥（PKCS#8 PEM，可将换行写成 \\n）。local 未配置时自动生成临时密钥；nonprod/prod 应配置稳定私钥。
AUTH_PASSWORD_ENCRYPTION_PRIVATE_KEY=

# 内测期每日简历分析次数。按 Asia/Shanghai 自然日重置；无限额用户 ID 以逗号分隔。
RESUME_DAILY_LIMIT=3
RESUME_QUOTA_TIME_ZONE=Asia/Shanghai
RESUME_QUOTA_UNLIMITED_USER_IDS=

# Harness runtime trace database
HARNESS_DATABASE_PATH=data/harness.sqlite
HARNESS_RETENTION_DAYS=7
HARNESS_MAX_RUNS=1000
HARNESS_CLEANUP_INTERVAL_MS=86400000

# Nonprod Supabase example:
# APP_ENV=nonprod
# DATABASE_PROVIDER=supabase
# AUTH_REQUIRED=true
# SUPABASE_PROJECT_ENV=nonprod
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# SUPABASE_SECRET_KEY=<secret-key>
# SUPABASE_STORAGE_BUCKET=user-files

# Prod Supabase example:
# APP_ENV=prod
# DATABASE_PROVIDER=supabase
# AUTH_REQUIRED=true
# SUPABASE_PROJECT_ENV=prod
# SUPABASE_URL=https://<prod-project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<prod-publishable-key>
# SUPABASE_SECRET_KEY=<prod-secret-key>
# SUPABASE_STORAGE_BUCKET=user-files

# SQLite -> Supabase migration script
# SQLITE_DATABASE_PATH=data/reffo.sqlite
# MIGRATION_USER_ID=<target-supabase-auth-user-id>
# DRY_RUN=true

# AI Provider Configuration
# 使用 DeepSeek API (兼容 OpenAI SDK)
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com

# 或使用 OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI Model Configuration
# 默认生产模型；提示词 A/B 运行器独立指定 Pro/Flash，不改动生产模型配置
AI_MODEL=deepseek-chat
# Explicit V4 mode for a separately authorized nonprod evaluation. Defaults do not migrate production.
# AI_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=default
DEEPSEEK_REASONING_EFFORT=high
# Thinking tokens and final output share this completion budget when callers omit maxOutputTokens.
DEEPSEEK_THINKING_MAX_TOKENS=12000
# 逗号分隔的 fallback 模型列表，主模型失败时按顺序尝试
AI_FALLBACK_MODELS=
# 兼容配置；正式 /process 链路使用本地代码门禁，不再调用 P11 外部 Judge
V5_QUALITY_JUDGE_ENABLED=false
# v5 Prompt 编译器的保守上下文窗口预算；超限时 fail-closed，不截断证据
V5_CONTEXT_WINDOW_TOKENS=64000
# auto：OpenAI 官方端点使用 native JSON Schema，其他兼容端点使用 JSON Object + 服务端严格 Zod
V5_STRUCTURED_OUTPUT_MODE=auto
# AI_MODEL=gpt-4

# v4.2 公开网络研究
# Jina Search/Reader API key；未配置时 Research Agent 必须返回 unavailable，禁止依赖模型记忆伪装联网
JINA_API_KEY=
WEB_RESEARCH_TIMEOUT_MS=20000

# GLM-OCR Configuration
# 兼容用户本地已有 GLM_API_KEY / GLM_ENDPOINT，也可使用 GLM_OCR_* 覆盖 OCR 专用配置
GLM_API_KEY=
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/layout_parsing
GLM_OCR_API_KEY=
GLM_OCR_ENDPOINT=
GLM_OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_OCR_MODEL=glm-ocr
OCR_TIMEOUT_MS=30000
OCR_MAX_FILE_SIZE_MB=10

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
# 支持逗号分隔多个来源；本地默认已允许 5173 / 4173 / 10086 常用 H5 端口
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:10086,http://127.0.0.1:10086
