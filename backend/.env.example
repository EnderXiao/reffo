# Environment Configuration

# Runtime Environment
# local: 本地开发，默认 SQLite；nonprod: 测试/预发合并环境；prod: 正式环境
APP_ENV=local
DATABASE_PROVIDER=sqlite
# local / nonprod 可设为 false 使用 DEV_USER_ID；prod 必须为 true
AUTH_REQUIRED=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Supabase Configuration
# nonprod/prod 使用各自 Supabase project 的 URL、Publishable key 和 Secret key
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 标记当前 Supabase project 属于非生产还是正式；DATABASE_PROVIDER=supabase 时必填
SUPABASE_PROJECT_ENV=

# Nonprod Supabase example:
# APP_ENV=nonprod
# DATABASE_PROVIDER=supabase
# AUTH_REQUIRED=false
# SUPABASE_PROJECT_ENV=nonprod
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# SUPABASE_SECRET_KEY=<secret-key>

# AI Provider Configuration
# 使用 DeepSeek API (兼容 OpenAI SDK)
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com

# 或使用 OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI Model Configuration
AI_MODEL=deepseek-chat
# 逗号分隔的 fallback 模型列表，主模型失败时按顺序尝试
AI_FALLBACK_MODELS=
# 服务端统一使用 final-v3 提示词，无需客户端或环境变量选择版本
# AI_MODEL=gpt-4

# GLM-OCR Configuration
# 兼容用户本地已有 GLM_API_KEY / GLM_ENDPOINT，也可使用 GLM_OCR_* 覆盖 OCR 专用配置
GLM_API_KEY=
GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/layout_parsing
GLM_OCR_API_KEY=
GLM_OCR_ENDPOINT=
GLM_OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_OCR_MODEL=glm-ocr
OCR_TIMEOUT_MS=30000
OCR_MAX_FILE_SIZE_MB=10

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
# 支持逗号分隔多个来源；本地默认已允许 5173 / 4173 / 10086 常用 H5 端口
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:10086,http://127.0.0.1:10086
