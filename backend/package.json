{
  "name": "reffo-backend",
  "version": "0.1.0",
  "description": "Reffo Backend - AI-powered resume optimization service",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env.local --watch src/index.ts",
    "dev:local": "bun --env-file=.env.local --watch src/index.ts",
    "dev:nonprod": "bun --env-file=.env.nonprod --watch src/index.ts",
    "dev:prod": "bun --env-file=.env.prod --watch src/index.ts",
    "start": "bun --env-file=.env.local run src/index.ts",
    "start:local": "bun --env-file=.env.local run src/index.ts",
    "start:nonprod": "bun --env-file=.env.nonprod run src/index.ts",
    "start:prod": "bun --env-file=.env.prod run src/index.ts",
    "test": "bun run src/test.ts",
    "test:unit": "bun test ./src",
    "migrate:sqlite-to-supabase": "bun --env-file=.env.nonprod run scripts/migrate-sqlite-to-supabase.ts",
    "migrate:sqlite-to-supabase:nonprod": "bun --env-file=.env.nonprod run scripts/migrate-sqlite-to-supabase.ts",
    "migrate:sqlite-to-supabase:prod": "bun --env-file=.env.prod run scripts/migrate-sqlite-to-supabase.ts"
  },
  "dependencies": {
    "elysia": "^1.0.0",
    "@elysiajs/swagger": "^1.0.0",
    "@elysiajs/cors": "^1.0.0",
    "openai": "^4.60.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "supabase": "^2.109.1",
    "typescript": "^5.3.0"
  }
}
